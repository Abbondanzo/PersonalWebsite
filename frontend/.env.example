GOOGLE_UA_KEY=
GOOGLE_UA_KEY_DEV=

# Contact form endpoint. Defaults to the deployed mail Worker; point it at
# http://localhost:8787/mail when running `pnpm dev:mail` alongside the site.
NUXT_PUBLIC_MAIL_ENDPOINT=

# Turnstile site key (public). Local testing: 1x00000000000000000000AA always
# passes, 2x00000000000000000000AB always blocks.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
