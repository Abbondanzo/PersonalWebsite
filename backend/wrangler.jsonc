{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abbondanzo-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  // mail.abbondanzo.com already has Cloudflare DNS (A/AAAA proxied). Custom
  // Domains refuse that ("externally managed DNS"), so attach via a route on
  // the existing hostname instead of asking Workers to own the record.
  // workers.dev stays enabled for smoke tests before the frontend cutover.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "mail.abbondanzo.com/*",
      "zone_name": "abbondanzo.com"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://abbondanzo.com,https://www.abbondanzo.com",
    "TURNSTILE_HOSTNAMES": "abbondanzo.com,www.abbondanzo.com",
    "ENVIRONMENT": "production"
  }
  // Secrets (wrangler secret put <NAME>, mirrored in .dev.vars for local dev):
  //   EMAILER_API_KEY, SENDER_EMAIL, RECEIVER_EMAIL, TURNSTILE_SECRET_KEY
}
