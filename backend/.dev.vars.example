# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# Values here override the vars declared in wrangler.jsonc.

# Postmark. Use POSTMARK_API_TEST to accept messages without delivering them.
EMAILER_API_KEY="POSTMARK_API_TEST"
SENDER_EMAIL=""
RECEIVER_EMAIL=""

# Turnstile test secrets:
#   1x0000000000000000000000000000000AA  always passes
#   2x0000000000000000000000000000000AA  always fails
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# The test secret reports the hostname the widget ran on; add localhost so
# tokens minted by `nuxt dev` are accepted.
TURNSTILE_HOSTNAMES="abbondanzo.com,www.abbondanzo.com,localhost"
ALLOWED_ORIGINS="https://abbondanzo.com,https://www.abbondanzo.com,http://localhost:3000"

# Unlocks GET /preview
ENVIRONMENT="development"
